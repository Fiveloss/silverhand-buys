# systemd unit. install.sh copies it to /etc/systemd/system/buybot.service with the
# real directory filled in. The limits keep the bot from ever starving other services
# on the same server: if it goes over, it is killed and restarted instead.
[Unit]
Description=Robinhood Chain buy bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__DIR__
ExecStart=__DIR__/venv/bin/python -m buybot.main
Restart=always
RestartSec=5
MemoryMax=300M
CPUQuota=30%
TasksMax=64
Nice=10
# Charts are drawn in worker threads; one malloc arena per thread made memory creep up.
Environment=MALLOC_ARENA_MAX=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
