# systemd unit. install.sh copies it to /etc/systemd/system/buybot.service with the
# real directory filled in. The limits keep the bot from ever starving other services
# on the same server: if it goes over, it is killed and restarted instead.
[Unit]
Description=Robinhood Chain buy bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__DIR__
ExecStart=__DIR__/venv/bin/python -m buybot.main
Restart=always
RestartSec=5
# Above MemoryHigh the kernel reclaims and slows the bot down instead of killing it; only
# MemoryMax kills. The bot itself draws one card at a time (buybot/heavy.py).
MemoryHigh=260M
MemoryMax=300M
CPUQuota=30%
TasksMax=64
Nice=10
# Charts are drawn in worker threads; one malloc arena per thread made memory creep up.
Environment=MALLOC_ARENA_MAX=2
# A card's image buffers (MBs each) are mapped and unmapped, not kept in the heap: glibc
# otherwise raises its mmap threshold after the first and holds the freed memory.
Environment=MALLOC_MMAP_THRESHOLD_=131072
Environment=MALLOC_TRIM_THRESHOLD_=131072
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
