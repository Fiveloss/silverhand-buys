# Copy to .env and fill in. Never commit .env.

# From @BotFather. Also there: /setjoingroups -> Enable. Privacy mode can stay ON.
BOT_TOKEN=

# Your Telegram user id (ask @userinfobot). Gets ads to review, payment and outage notices,
# and the /stats /grantpro /refund /ads commands. Several: 111,222
OWNER_IDS=

# Chart button. {token} is replaced with the token address.
# After you get a GMGN referral code, put it in the way your GMGN cabinet shows, e.g.
# TRADE_URL=https://gmgn.ai/robinhood/token/YOURCODE_{token}
TRADE_URL=https://gmgn.ai/robinhood/token/{token}

# Prices in Telegram Stars (you receive about $0.013 per star, withdrawable 21 days after payment).
# Pro, per chat: weeks:stars pairs.
PRO_PLANS=1:500,4:1500
AD_DAY_STARS=750
AD_MAX_DAYS=7

# Shown by /paysupport, e.g. @yourname
SUPPORT_CONTACT=

# Link to this bot's source code, shown in /terms. The AGPL asks anyone running a
# modified copy as a service to offer its source to users.
SOURCE_URL=

# Defaults below are fine.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
DB_PATH=data/bot.db
POLL_SECONDS=3
RPC_MIN_INTERVAL=0.3
LOG_LEVEL=INFO
